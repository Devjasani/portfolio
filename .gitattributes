# Auto-detect text files and enforce LF on all platforms
* text=auto eol=lf

# Force LF for all source files
*.tsx      text eol=lf
*.ts       text eol=lf
*.js       text eol=lf
*.jsx      text eol=lf
*.css      text eol=lf
*.html     text eol=lf
*.json     text eol=lf
*.yaml     text eol=lf
*.yml      text eol=lf
*.md       text eol=lf

# Binary — do not touch
*.jpg      binary
*.jpeg     binary
*.png      binary
*.webp     binary
*.gif      binary
*.svg      binary
*.ico      binary
*.pdf      binary
*.lottie   binary
*.mp4      binary
